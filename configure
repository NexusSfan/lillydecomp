#!/usr/bin/env bash

# SPDX-License-Identifier: CC0-1.0

DIR=$( dirname -- "${BASH_SOURCE[0]}" )

# Check for dasm
echo -n "Checking for dasm... "

DASM=$(command -v dasm)
if [ -z "$DASM" ]; then
    echo "not found"
    exit 1
else
    echo "$DASM"
fi

cp $DIR/Makefile.in Makefile

# replace variables
sed -i "s|ASM = |ASM = $DASM|g" Makefile
sed -i "s|SRC = |SRC = $DIR|g" Makefile
