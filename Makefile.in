# SPDX-License-Identifier: CC0-1.0

ASM = 
BIN = PlayLilly.bin LILLY.bin

all: $(BIN)

LILLY.bin:
	cd asm; \
	$(ASM) LILLY.asm -f3 -oLILLY.bin
	mv asm/LILLY.bin LILLY.bin

PlayLilly.bin:
	cd asm; \
	$(ASM) PlayLilly.asm -f3 -oPlayLilly.bin
	mv asm/PlayLilly.bin PlayLilly.bin

clean:
	rm $(BIN)

distclean: clean
	rm Makefile
