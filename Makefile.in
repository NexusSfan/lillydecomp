# SPDX-License-Identifier: CC0-1.0

ASM = 
BIN = immortal.bin PlayLilly.bin

all: $(BIN)

immortal.bin:
	cd asm; \
	$(ASM) immortal\ lilly.asm -f3 -oimmortal.bin
	mv asm/immortal.bin immortal.bin

PlayLilly.bin:
	cd asm; \
	$(ASM) PlayLilly.asm -f3 -oPlayLilly.bin
	mv asm/PlayLilly.bin PlayLilly.bin

clean:
	rm $(BIN)

distclean: clean
	rm Makefile
