# SPDX-License-Identifier: CC0-1.0

CL = 
BIN = hello.bin lilly.bin game.bin

all: $(BIN)

lilly.bin:
	cd src; \
	$(CL) -t atari2600 -O -o lilly.bin lilly.c
	mv src/lilly.bin lilly.bin

hello.bin:
	cd src; \
	$(CL) -t atari2600 -O -o hello.bin hello.c
	mv src/hello.bin hello.bin

game.bin:
	cd src; \
	$(CL) -t atari2600 -O -o game.bin game.c
	mv src/game.bin game.bin

clean:
	rm $(BIN)

distclean: clean
	rm Makefile
